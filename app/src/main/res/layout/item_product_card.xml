<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_product_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Image Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_product_image_area">

        <!-- Badge (New / -20%) — set visibility in code -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/product_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_product_badge_new"
            android:letterSpacing="0.05"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="New"
            tools:visibility="visible" />

        <!-- Product Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/product_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:contentDescription="@string/home_product_image_desc"
            android:scaleType="fitCenter"
            tools:src="@tools:sample/avatars" />
    </FrameLayout>

    <!-- Info Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Category Label -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/product_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="ELECTRONICS" />

        <!-- Product Name -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Sonic Pro Wireless Headphones" />

        <!-- Price Row + Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Prices -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="$299" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/product_original_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="$150"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Add Button -->
            <ImageButton
                android:id="@+id/btn_add_to_cart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_add_button"
                android:contentDescription="@string/home_add_to_cart"
                android:scaleType="center"
                android:src="@drawable/ic_add" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
