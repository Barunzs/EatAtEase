<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stitch_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <!-- ═══════════════════════════════════════════ -->
        <!-- Search Bar                                  -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/stitch_outline" />

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/home_search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/stitch_on_surface"
                android:textColorHint="@color/stitch_outline_variant"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_cart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_cart"
                android:src="@drawable/ic_shopping_cart"
                app:tint="@color/stitch_primary" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Category Chips Horizontal Scroll            -->
        <!-- ═══════════════════════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/category_chips_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            app:layoutManager="LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_category_chip" />

        <!-- ═══════════════════════════════════════════ -->
        <!-- Hero Banner                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <FrameLayout
            android:id="@+id/hero_banner"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero_banner"
            android:clipToOutline="true"
            android:elevation="6dp">

            <!-- Text + Button overlay on banner -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Summer Sale Badge -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hero_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_badge"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/home_hero_badge"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Headline -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/home_hero_title"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/hero_subtitle"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:text="@string/home_hero_subtitle"
                    android:textColor="@color/stitch_primary_fixed_dim"
                    android:textSize="13sp" />

                <!-- Shop Now Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_shop_now"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_shop_now_button"
                    android:letterSpacing="0.01"
                    android:paddingHorizontal="24dp"
                    android:text="@string/home_shop_now"
                    android:textAllCaps="false"
                    android:textColor="@color/stitch_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="999dp"
                    app:elevation="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Featured Products Header                    -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/featured_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_featured_products"
                android:textColor="@color/stitch_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/btn_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.01"
                android:text="@string/home_view_all"
                android:textColor="@color/stitch_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Products Grid (2 columns via GridLayoutManager) -->
        <!-- ═══════════════════════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/products_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="4"
            tools:listitem="@layout/item_product_card" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>