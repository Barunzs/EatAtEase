<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stitch_background"
    android:scrollbars="none"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════ -->
        <!-- Hero Header — gradient, 280dp               -->
        <!-- ═══════════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/bg_profile_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="48dp">

                <!-- Avatar with camera badge -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- Circular profile photo -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_profile_photo"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@color/stitch_primary_container"
                        android:contentDescription="Profile photo"
                        android:padding="20dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:shapeAppearanceOverlay="@style/CircleImageStyle"
                        app:strokeColor="#60FFFFFF"
                        app:strokeWidth="3dp"
                        app:tint="#FFFFFF" />

                    <!-- Camera badge button -->
                    <FrameLayout
                        android:id="@+id/btn_change_photo"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_camera_badge"
                        android:clickable="true"
                        android:contentDescription="Change profile photo"
                        android:elevation="4dp"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Display name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Barun Singh" />

                <!-- Phone / email subtitle -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_profile_identifier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    tools:text="+91 98765 43210" />

                <!-- Premium Member badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_hero_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Premium Member"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Cards Section (overlaps hero by -24dp)      -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="100dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- Edit Profile Name Card                  -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/stitch_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/stitch_surface_container_highest"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="16dp"
                    android:paddingTop="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.07"
                        android:text="EDIT PROFILE"
                        android:textColor="@color/stitch_outline"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Name display row (shown when NOT editing) -->
                    <LinearLayout
                        android:id="@+id/row_name_display"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_primary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_profile"
                                app:tint="@color/stitch_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Display Name"
                                android:textColor="@color/stitch_outline"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_display_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/stitch_on_surface"
                                android:textSize="15sp"
                                tools:text="Barun Singh" />
                        </LinearLayout>

                        <!-- Edit pencil button -->
                        <ImageButton
                            android:id="@+id/btn_edit_name"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Edit name"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/stitch_primary" />
                    </LinearLayout>

                    <!-- Name edit row (shown when editing) -->
                    <LinearLayout
                        android:id="@+id/row_name_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/selector_login_input_bg"
                            android:orientation="vertical"
                            android:paddingBottom="10dp"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.05"
                                android:text="Your Name"
                                android:textColor="@color/stitch_on_surface_variant"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/edit_name_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:hint="Enter your name"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLines="1"
                                android:minHeight="32dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/stitch_on_surface"
                                android:textColorHint="@color/stitch_outline_variant"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <!-- Save / Cancel buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_cancel_name"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:text="Cancel"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:cornerRadius="999dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_save_name"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="Save"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/stitch_primary"
                                app:cornerRadius="999dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Account Info Card                       -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/stitch_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/stitch_surface_container_highest"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.07"
                        android:text="ACCOUNT"
                        android:textColor="@color/stitch_outline"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Phone row -->
                    <LinearLayout
                        android:id="@+id/row_phone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_primary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/stitch_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phone Number"
                                android:textColor="@color/stitch_outline"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_profile_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/stitch_on_surface"
                                android:textSize="15sp"
                                tools:text="+91 98765 43210" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_phone"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:background="@color/stitch_surface_container_highest"
                        android:visibility="gone" />

                    <!-- Email row -->
                    <LinearLayout
                        android:id="@+id/row_email"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tertiary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_email"
                                app:tint="@color/stitch_tertiary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email Address"
                                android:textColor="@color/stitch_outline"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_profile_email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/stitch_on_surface"
                                android:textSize="15sp"
                                tools:text="user@example.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider before sign-in method -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:background="@color/stitch_surface_container_highest" />

                    <!-- Auth method row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_secondary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_secure"
                                app:tint="@color/stitch_secondary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sign-in method"
                                android:textColor="@color/stitch_outline"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_profile_auth_method"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/stitch_on_surface"
                                android:textSize="15sp"
                                tools:text="Phone (OTP)" />
                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="Verified"
                            android:textColor="@color/success_text"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@color/success_bg"
                            app:chipCornerRadius="12dp"
                            app:chipStrokeColor="@color/success_stroke"
                            app:chipStrokeWidth="1dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Preferences Card                        -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/stitch_surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/stitch_surface_container_highest"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.07"
                        android:text="PREFERENCES"
                        android:textColor="@color/stitch_outline"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- My Orders Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_primary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_shopping_cart"
                                app:tint="@color/stitch_primary" />
                        </FrameLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="My Orders"
                            android:textColor="@color/stitch_on_surface"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/stitch_outline_variant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:background="@color/stitch_surface_container_highest" />

                    <!-- Saved Addresses Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_tertiary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_location"
                                app:tint="@color/stitch_tertiary" />
                        </FrameLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Saved Addresses"
                            android:textColor="@color/stitch_on_surface"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/stitch_outline_variant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="54dp"
                        android:background="@color/stitch_surface_container_highest" />

                    <!-- Payment Methods Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_secondary_fixed">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_credit_card"
                                app:tint="@color/stitch_secondary" />
                        </FrameLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Payment Methods"
                            android:textColor="@color/stitch_on_surface"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/stitch_outline_variant" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Logout Button                           -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_logout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_logout_button"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="@color/stitch_on_error"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/stitch_on_error"
                app:rippleColor="#40FFFFFF" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
