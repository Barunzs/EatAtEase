<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page_alt"
    android:scrollbars="none"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════ -->
        <!-- Hero Header                             -->
        <!-- ═══════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_login_gradient">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="40dp">

                <!-- Avatar with camera badge -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- Circular profile photo -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_profile_photo"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:shapeAppearanceOverlay="@style/CircleImageStyle"
                        app:strokeColor="@color/avatar_stroke"
                        app:strokeWidth="2dp"
                        android:background="@color/avatar_bg"
                        android:padding="18dp"
                        app:tint="#FFFFFF"
                        android:contentDescription="Profile photo" />

                    <!-- Camera badge button -->
                    <FrameLayout
                        android:id="@+id/btn_change_photo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_camera_badge"
                        android:elevation="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Change profile photo">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_camera"
                            android:importantForAccessibility="no"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Display name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Barun Singh" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_profile_identifier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    tools:text="+91 98765 43210" />
            </LinearLayout>
        </FrameLayout>

        <!-- Overlap cards section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="-24dp"
            android:paddingHorizontal="16dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- Edit Name Card                          -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07"
                        android:layout_marginBottom="12dp" />

                    <!-- Name display row (shown when NOT editing) -->
                    <LinearLayout
                        android:id="@+id/row_name_display"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profile"
                            android:importantForAccessibility="no"
                            app:tint="@color/brand_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Display Name"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_display_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:text="Barun Singh" />
                        </LinearLayout>

                        <!-- Edit pencil button -->
                        <ImageButton
                            android:id="@+id/btn_edit_name"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_edit"
                            android:contentDescription="Edit name"
                            app:tint="@color/brand_accent" />
                    </LinearLayout>

                    <!-- Name edit row (shown when editing) -->
                    <LinearLayout
                        android:id="@+id/row_name_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Name input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/selector_login_input_bg"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="10dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your Name"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <EditText
                                android:id="@+id/edit_name_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:hint="Enter your name"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLines="1"
                                android:minHeight="32dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_input_hint"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <!-- Save / Cancel buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_cancel_name"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:text="Cancel"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:cornerRadius="999dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_save_name"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="Save"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/save_button_bg"
                                app:cornerRadius="999dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Account Info Card                       -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07"
                        android:layout_marginBottom="8dp" />

                    <!-- Phone row -->
                    <LinearLayout
                        android:id="@+id/row_phone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_phone"
                            android:importantForAccessibility="no"
                            app:tint="@color/brand_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phone Number"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_profile_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:text="+91 98765 43210" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_phone"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_divider"
                        android:visibility="gone" />

                    <!-- Email row -->
                    <LinearLayout
                        android:id="@+id/row_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_email"
                            android:importantForAccessibility="no"
                            app:tint="@color/brand_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email Address"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_profile_email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:text="user@example.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Auth method row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_secure"
                            android:importantForAccessibility="no"
                            app:tint="@color/brand_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sign-in method"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_profile_auth_method"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:text="Phone (OTP)" />
                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verified"
                            android:textSize="11sp"
                            android:textColor="@color/success_text"
                            android:clickable="false"
                            android:focusable="false"
                            app:chipBackgroundColor="@color/success_bg"
                            app:chipCornerRadius="12dp"
                            app:chipStrokeColor="@color/success_stroke"
                            app:chipStrokeWidth="1dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Preferences Card                        -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferences"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_shopping_cart"
                            android:importantForAccessibility="no"
                            app:tint="@color/icon_tint_secondary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="My Orders"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="@color/chevron_tint" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_location"
                            android:importantForAccessibility="no"
                            app:tint="@color/icon_tint_secondary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Saved Addresses"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="@color/chevron_tint" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_credit_card"
                            android:importantForAccessibility="no"
                            app:tint="@color/icon_tint_secondary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Payment Methods"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="@color/chevron_tint" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Logout Button                           -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_logout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_login_button"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
