<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    tools:context=".LoginActivity">

    <!-- Background Decorative Blobs -->
    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-60dp"
        android:layout_marginTop="-60dp"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_login_blob_primary" />

    <ImageView
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-80dp"
        android:alpha="0.3"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_login_blob_secondary" />

    <!-- Main Login Card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="32dp">

                <!-- ═══════════════════════════════════ -->
                <!-- Logo & Header                       -->
                <!-- ═══════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_marginBottom="32dp">

                    <!-- Logo Circle -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_login_logo_circle"
                        android:elevation="4dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🛍️"
                            android:textSize="32sp" />
                    </FrameLayout>

                    <!-- App Title -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/login_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.02"
                        android:text="@string/app_name"
                        android:textColor="@color/stitch_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/login_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/login_subtitle"
                        android:textAlignment="center"
                        android:textColor="@color/stitch_on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ═══════════════════════════════════ -->
                <!-- Segmented Tab Toggle                -->
                <!-- ═══════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_search_bar"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- Email Tab -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tab_email_btn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_login_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Email"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Phone Tab -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tab_phone_btn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Phone OTP"
                        android:textColor="@color/stitch_outline"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- EMAIL / PASSWORD FORM (default visible)     -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/email_password_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Email Input -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.05"
                        android:text="@string/login_email_label"
                        android:textColor="@color/stitch_on_surface_variant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/email_container"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/selector_login_input_bg"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <EditText
                            android:id="@+id/edit_email"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:autofillHints="emailAddress"
                            android:background="@android:color/transparent"
                            android:hint="@string/login_email_hint"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/stitch_on_surface"
                            android:textColorHint="@color/stitch_outline_variant"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- Password Header Row (label + forgot) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:layout_marginBottom="6dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.05"
                            android:text="@string/login_password_label"
                            android:textColor="@color/stitch_on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_forgot_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/login_forgot_password"
                            android:textColor="@color/stitch_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Password Input -->
                    <LinearLayout
                        android:id="@+id/password_container"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/selector_login_input_bg"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <EditText
                            android:id="@+id/edit_password"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:autofillHints="password"
                            android:background="@android:color/transparent"
                            android:hint="@string/login_password_hint"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/stitch_on_surface"
                            android:textColorHint="@color/stitch_outline_variant"
                            android:textSize="15sp" />

                        <!-- Toggle Password Visibility -->
                        <ImageButton
                            android:id="@+id/btn_toggle_password"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/login_toggle_password"
                            android:src="@drawable/ic_visibility_off"
                            app:tint="@color/stitch_outline" />
                    </LinearLayout>

                    <!-- Remember Me & Forgot Password Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/checkbox_remember_me"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:text="@string/login_remember_me"
                            android:textColor="@color/stitch_on_surface_variant"
                            android:textSize="13sp"
                            app:buttonTint="@color/stitch_primary" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="24dp" />

                    <!-- Sign In Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_login_button"
                        android:elevation="4dp"
                        android:letterSpacing="0.05"
                        android:text="@string/login_sign_in"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="999dp"
                        app:rippleColor="#40FFFFFF" />

                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- OTP LOGIN FORM (hidden by default)          -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/otp_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Phone Number Label -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:letterSpacing="0.05"
                        android:text="@string/login_phone_label"
                        android:textColor="@color/stitch_on_surface_variant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Phone Number Input -->
                    <LinearLayout
                        android:id="@+id/phone_container"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/selector_login_input_bg"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/stitch_outline" />

                        <EditText
                            android:id="@+id/edit_phone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:autofillHints="phone"
                            android:background="@android:color/transparent"
                            android:hint="@string/login_phone_hint"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/stitch_on_surface"
                            android:textColorHint="@color/stitch_outline_variant"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="We'll send a secure one-time password to verify your account."
                        android:textAlignment="center"
                        android:textColor="@color/stitch_outline"
                        android:textSize="12sp" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- Send OTP Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_otp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_login_button"
                        android:elevation="4dp"
                        android:letterSpacing="0.05"
                        android:text="@string/login_send_otp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="999dp"
                        app:rippleColor="#40FFFFFF" />

                    <!-- OTP Input Section (shown after Send OTP) -->
                    <LinearLayout
                        android:id="@+id/otp_input_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- OTP Sent Message -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/otp_sent_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:textColor="@color/success_text"
                            android:textSize="13sp"
                            tools:text="OTP sent to +91 98765 43210" />

                        <!-- OTP Label -->
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp"
                            android:letterSpacing="0.05"
                            android:text="@string/login_otp_label"
                            android:textColor="@color/stitch_on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- OTP Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/selector_login_input_bg"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <EditText
                                android:id="@+id/edit_otp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:hint="@string/login_otp_hint"
                                android:inputType="number"
                                android:letterSpacing="0.3"
                                android:maxLength="6"
                                android:maxLines="1"
                                android:textColor="@color/stitch_on_surface"
                                android:textColorHint="@color/stitch_outline_variant"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Resend Timer -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_resend_otp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:text="@string/login_resend_otp"
                                android:textColor="@color/stitch_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp" />

                        <!-- Verify OTP Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_verify_otp"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_login_button"
                            android:elevation="4dp"
                            android:letterSpacing="0.05"
                            android:text="@string/login_verify_otp"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="999dp"
                            app:rippleColor="#40FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- Progress Bar (shared, initially hidden)     -->
                <!-- ═══════════════════════════════════════════ -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/login_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/stitch_primary"
                    app:indicatorSize="36dp"
                    app:trackCornerRadius="4dp" />

                <!-- ═══════════════════════════════════════════ -->
                <!-- OR Divider + Mode Toggle                    -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/stitch_outline_variant" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="@string/login_or"
                        android:textColor="@color/stitch_outline"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/stitch_outline_variant" />
                </LinearLayout>

                <!-- Toggle Login Mode Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_login_mode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_login_outlined_button"
                    android:visibility="gone"
                    android:letterSpacing="0.01"
                    android:text="@string/login_switch_to_otp"
                    android:textAllCaps="false"
                    android:textColor="@color/stitch_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/ic_phone"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/stitch_primary"
                    app:rippleColor="@color/brand_accent_alpha"
                    app:strokeColor="@color/stitch_primary"
                    app:strokeWidth="1.5dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!-- Sign Up Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_no_account"
                        android:textColor="@color/stitch_on_surface_variant"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/text_sign_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/login_sign_up"
                        android:textColor="@color/stitch_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Terms Footer -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="By continuing, you agree to our Terms of Service &amp; Privacy Policy"
                    android:textAlignment="center"
                    android:textColor="@color/stitch_outline_variant"
                    android:textSize="11sp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
