<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  EatAtEase — Material Design 3 Dark Theme                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Theme.EatAtEase" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary (Indigo) -->
        <item name="colorPrimary">@color/md_primary_80</item>
        <item name="colorOnPrimary">@color/md_primary_20</item>
        <item name="colorPrimaryContainer">@color/md_primary_30</item>
        <item name="colorOnPrimaryContainer">@color/md_primary_90</item>

        <!-- Secondary (Slate blue) -->
        <item name="colorSecondary">@color/md_secondary_80</item>
        <item name="colorOnSecondary">@color/md_secondary_30</item>
        <item name="colorSecondaryContainer">@color/md_secondary_30</item>
        <item name="colorOnSecondaryContainer">@color/md_secondary_90</item>

        <!-- Tertiary (Saffron accent) -->
        <item name="colorTertiary">@color/md_tertiary_80</item>
        <item name="colorOnTertiary">@color/md_tertiary_30</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_30</item>
        <item name="colorOnTertiaryContainer">@color/md_tertiary_90</item>

        <!-- Error -->
        <item name="colorError">@color/md_error_80</item>
        <item name="colorOnError">@color/md_error_40</item>
        <item name="colorErrorContainer">@color/md_error_40</item>
        <item name="colorOnErrorContainer">@color/md_error_90</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/md_neutral_06</item>
        <item name="colorOnSurface">@color/md_neutral_90</item>
        <item name="colorSurfaceVariant">@color/md_neutral_var_30</item>
        <item name="colorOnSurfaceVariant">@color/md_neutral_var_80</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_neutral_var_60</item>
        <item name="colorOutlineVariant">@color/md_neutral_var_30</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Shape — MD3 scale -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EatAtEase.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.EatAtEase.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.EatAtEase.Large</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.EatAtEase.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.EatAtEase.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.EatAtEase.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.EatAtEase.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.EatAtEase.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.EatAtEase.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.EatAtEase.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.EatAtEase.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.EatAtEase.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.EatAtEase.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.EatAtEase.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.EatAtEase.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.EatAtEase.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.EatAtEase.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.EatAtEase.LabelSmall</item>
    </style>

    <!-- ─── Sub-themes ─────────────────────────────────────────── -->

    <style name="Theme.EatAtEase.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.EatAtEase.AppBarOverlay" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorPrimary">@color/md_neutral_06</item>
        <item name="colorOnPrimary">@color/md_neutral_90</item>
    </style>

    <style name="Theme.EatAtEase.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />

    <!-- Dark splash -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_neutral_06</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/round_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.EatAtEase</item>
    </style>

    <style name="Theme.EatAtEase.Login" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary_80</item>
        <item name="colorOnPrimary">@color/md_primary_20</item>
        <item name="colorPrimaryContainer">@color/md_primary_30</item>
        <item name="colorOnPrimaryContainer">@color/md_primary_90</item>
        <item name="colorSecondary">@color/md_secondary_80</item>
        <item name="colorSecondaryContainer">@color/md_secondary_30</item>
        <item name="colorSurface">@color/md_neutral_06</item>
        <item name="colorOnSurface">@color/md_neutral_90</item>
        <item name="colorOnSurfaceVariant">@color/md_neutral_var_80</item>
        <item name="colorOutline">@color/md_neutral_var_60</item>
        <item name="colorOutlineVariant">@color/md_neutral_var_30</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>