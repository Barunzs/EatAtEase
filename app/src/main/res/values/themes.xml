<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  EatAtEase — Material Design 3 Light Theme                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Theme.EatAtEase" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary (Indigo) -->
        <item name="colorPrimary">@color/md_primary_40</item>
        <item name="colorOnPrimary">@color/md_primary_100</item>
        <item name="colorPrimaryContainer">@color/md_primary_90</item>
        <item name="colorOnPrimaryContainer">@color/md_primary_10</item>

        <!-- Secondary (Slate blue) -->
        <item name="colorSecondary">@color/md_secondary_40</item>
        <item name="colorOnSecondary">@color/md_neutral_100</item>
        <item name="colorSecondaryContainer">@color/md_secondary_90</item>
        <item name="colorOnSecondaryContainer">@color/md_secondary_30</item>

        <!-- Tertiary (Saffron accent) -->
        <item name="colorTertiary">@color/md_tertiary_40</item>
        <item name="colorOnTertiary">@color/md_neutral_100</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_90</item>
        <item name="colorOnTertiaryContainer">@color/md_tertiary_10</item>

        <!-- Error -->
        <item name="colorError">@color/md_error_40</item>
        <item name="colorOnError">@color/md_neutral_100</item>
        <item name="colorErrorContainer">@color/md_error_90</item>
        <item name="colorOnErrorContainer">@color/md_tertiary_10</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/md_neutral_98</item>
        <item name="colorOnSurface">@color/md_neutral_10</item>
        <item name="colorSurfaceVariant">@color/md_neutral_var_90</item>
        <item name="colorOnSurfaceVariant">@color/md_neutral_var_30</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_neutral_var_50</item>
        <item name="colorOutlineVariant">@color/md_neutral_var_80</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Shape — MD3 scale -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EatAtEase.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.EatAtEase.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.EatAtEase.Large</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.EatAtEase.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.EatAtEase.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.EatAtEase.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.EatAtEase.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.EatAtEase.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.EatAtEase.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.EatAtEase.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.EatAtEase.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.EatAtEase.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.EatAtEase.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.EatAtEase.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.EatAtEase.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.EatAtEase.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.EatAtEase.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.EatAtEase.LabelSmall</item>
    </style>

    <!-- ─── Sub-themes ─────────────────────────────────────────── -->

    <style name="Theme.EatAtEase.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.EatAtEase.AppBarOverlay" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorPrimary">@color/md_neutral_98</item>
        <item name="colorOnPrimary">@color/md_neutral_10</item>
    </style>

    <style name="Theme.EatAtEase.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/round_icon</item>
        <item name="windowSplashScreenBackground">@color/md_primary_40</item>
        <item name="postSplashScreenTheme">@style/Theme.EatAtEase</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.EatAtEase.Login" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary_40</item>
        <item name="colorOnPrimary">@color/md_neutral_100</item>
        <item name="colorPrimaryContainer">@color/md_primary_90</item>
        <item name="colorOnPrimaryContainer">@color/md_primary_10</item>
        <item name="colorSecondary">@color/md_secondary_40</item>
        <item name="colorSecondaryContainer">@color/md_secondary_90</item>
        <item name="colorSurface">@color/md_neutral_98</item>
        <item name="colorOnSurface">@color/md_neutral_10</item>
        <item name="colorOnSurfaceVariant">@color/md_neutral_var_30</item>
        <item name="colorOutline">@color/md_neutral_var_50</item>
        <item name="colorOutlineVariant">@color/md_neutral_var_80</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- ─── MD3 Shape Scale ───────────────────────────────────── -->

    <style name="ShapeAppearance.EatAtEase.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.EatAtEase.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.EatAtEase.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Circular shape for profile photo -->
    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ─── MD3 Typography Scale ──────────────────────────────── -->

    <style name="TextAppearance.EatAtEase.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.EatAtEase.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.EatAtEase.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.EatAtEase.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.EatAtEase.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.EatAtEase.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.EatAtEase.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.EatAtEase.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">sans-serif-medium</item>
    </style>

</resources>